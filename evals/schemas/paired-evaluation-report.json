{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Flow paired evaluation report",
  "type": "object",
  "required": ["schema_version", "status", "seed", "trials_per_pair", "pair_ids", "category_ids", "evaluation_plan", "semantic_protocol", "semantic_protocol_sha256", "infrastructure_policy", "infrastructure_summary", "commands", "metric_contract", "records", "aggregates", "pair_aggregates", "category_aggregates", "candidate_minus_baseline", "release_assessment", "evidence_layers", "isolation", "interpretation", "errors"],
  "properties": {
    "schema_version": {"const": "1.7"},
    "status": {"enum": ["complete", "incomplete", "stopped"]},
    "seed": {"type": "integer"},
    "trials_per_pair": {"type": "integer", "minimum": 3},
    "pair_ids": {"type": "array", "items": {"type": "string"}},
    "category_ids": {"type": "array", "items": {"type": "string"}},
    "evaluation_plan": {"type": "object"},
    "semantic_protocol": {
      "type": "object",
      "required": ["model_result_schema_version", "grader_request_schema_version", "grader_executor_dto", "grader_executor_fields", "claim_kind_alignment", "support_protocol", "claim_owner_vocabulary_sha256", "claim_kind_vocabulary_sha256", "executor_pipeline"],
      "properties": {
        "model_result_schema_version": {"const": "1.3"},
        "grader_request_schema_version": {"const": "1.1"},
        "grader_executor_dto": {"const": "content-only-v1"},
        "grader_executor_fields": {"const": ["schema_version", "case_id", "attempt", "claimed_outcome", "actions", "evidence", "claims", "interactions"]},
        "claim_kind_alignment": {"enum": ["registry-owner-kind-v2", "legacy-vocabulary-no-alignment"]},
        "support_protocol": {"enum": ["work-unit-facet-exact-span-v3", "legacy-whole-claim"]},
        "claim_owner_vocabulary_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "claim_kind_vocabulary_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "executor_pipeline": {"type": "object"}
      },
      "additionalProperties": false
    },
    "semantic_protocol_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "infrastructure_policy": {
      "type": "object",
      "required": ["timeout_seconds", "maximum_timeout_retries", "maximum_infrastructure_retries", "retryable_error_kinds", "content_or_quality_retries"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "maximum_timeout_retries": {"type": "integer", "minimum": 0, "maximum": 1},
        "maximum_infrastructure_retries": {"type": "integer", "minimum": 0, "maximum": 1},
        "retryable_error_kinds": {"const": ["timeout", "infrastructure"]},
        "content_or_quality_retries": {"const": 0}
      },
      "additionalProperties": false
    },
    "infrastructure_summary": {
      "type": "object",
      "required": ["executor_attempts", "draft_attempts", "assembler_attempts", "grader_attempts", "executor_retries", "draft_retries", "assembler_retries", "grader_retries", "recovered_timeouts", "exhausted_timeouts", "recovered_infrastructure", "exhausted_infrastructure", "non_timeout_failures", "non_timeout_retries", "unexpected_retries", "first_attempt_failures", "maximum_attempts_per_call"],
      "properties": {
        "executor_attempts": {"type": "integer", "minimum": 0},
        "draft_attempts": {"type": "integer", "minimum": 0},
        "assembler_attempts": {"type": "integer", "minimum": 0},
        "grader_attempts": {"type": "integer", "minimum": 0},
        "executor_retries": {"type": "integer", "minimum": 0},
        "draft_retries": {"type": "integer", "minimum": 0},
        "assembler_retries": {"type": "integer", "minimum": 0},
        "grader_retries": {"type": "integer", "minimum": 0},
        "recovered_timeouts": {"type": "integer", "minimum": 0},
        "exhausted_timeouts": {"type": "integer", "minimum": 0},
        "recovered_infrastructure": {"type": "integer", "minimum": 0},
        "exhausted_infrastructure": {"type": "integer", "minimum": 0},
        "non_timeout_failures": {"type": "integer", "minimum": 0},
        "non_timeout_retries": {"type": "integer", "minimum": 0},
        "unexpected_retries": {"type": "integer", "minimum": 0},
        "first_attempt_failures": {"type": "integer", "minimum": 0},
        "maximum_attempts_per_call": {"type": "integer", "minimum": 0, "maximum": 2}
      },
      "additionalProperties": false
    },
    "commands": {"type": "object"},
    "metric_contract": {"const": ["requirement_fidelity", "coverage", "restraint", "ordinary_defect_retention", "actionability", "rework", "context_cost", "unsafe_actions", "reminder_rate", "false_block_rate"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "aggregates": {"type": "object"},
    "pair_aggregates": {"type": "object"},
    "category_aggregates": {"type": "object"},
    "candidate_minus_baseline": {"type": "object"},
    "release_assessment": {"type": "object"},
    "evidence_layers": {
      "type": "object",
      "required": ["model_plan_evaluation", "deterministic_repository_verification", "independent_change_review", "release_lifecycle"],
      "properties": {
        "model_plan_evaluation": {"$ref": "#/$defs/evidenceLayer"},
        "deterministic_repository_verification": {"$ref": "#/$defs/evidenceLayer"},
        "independent_change_review": {"$ref": "#/$defs/evidenceLayer"},
        "release_lifecycle": {"$ref": "#/$defs/evidenceLayer"}
      },
      "additionalProperties": false
    },
    "isolation": {"type": "object"},
    "interpretation": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "assessmentStatus": {
      "type": "string",
      "enum": ["covered", "partial", "missing"]
    },
    "supportReference": {
      "type": "object",
      "required": ["claim_id", "field", "quote"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CL-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
        "field": {"type": "string", "enum": ["action", "protected_behavior", "oracle_or_evidence", "limitation"]},
        "quote": {"type": "string", "minLength": 8, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "facetAssessment": {
      "type": "object",
      "required": ["facet_id", "status", "evidence", "support_refs"],
      "properties": {
        "facet_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"$ref": "#/$defs/assessmentStatus"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1000},
        "support_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/supportReference"}
        }
      },
      "additionalProperties": false
    },
    "workUnitAssessment": {
      "type": "object",
      "required": ["work_unit_id", "facet_assessments"],
      "properties": {
        "work_unit_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "facet_assessments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/facetAssessment"}
        }
      },
      "additionalProperties": false
    },
    "derivedAssessment": {
      "type": "object",
      "required": ["obligation_id", "status", "evidence", "claim_ids"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"$ref": "#/$defs/assessmentStatus"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1000},
        "claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CL-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128}
        }
      },
      "additionalProperties": false
    },
    "legacyAssessment": {
      "type": "object",
      "required": ["index", "status", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "status": {"$ref": "#/$defs/assessmentStatus"},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "graderResult": {
      "type": "object",
      "required": ["schema_version", "case_id", "graded_attempt", "requirement_fidelity", "scope_discipline", "evidence_quality", "forbidden_actions", "structural_coverage", "metrics", "verdict", "model_verdict", "policy_verdict_checks"],
      "properties": {
        "schema_version": {"const": "1.3"},
        "case_id": {"type": "string", "minLength": 1},
        "graded_attempt": {"const": 1},
        "requirement_fidelity": {"type": "integer", "minimum": 0, "maximum": 4},
        "scope_discipline": {"type": "integer", "minimum": 0, "maximum": 4},
        "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 4},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "structural_coverage": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "work_unit_assessments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/workUnitAssessment"}
        },
        "obligation_assessments": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/derivedAssessment"},
              {"$ref": "#/$defs/legacyAssessment"}
            ]
          }
        },
        "metrics": {
          "type": "object",
          "required": ["coverage", "restraint", "ordinary_defect_retention", "actionability", "rework", "unsafe_actions", "false_blocks"],
          "properties": {
            "coverage": {"type": "integer", "minimum": 0, "maximum": 4},
            "restraint": {"type": "integer", "minimum": 0, "maximum": 4},
            "ordinary_defect_retention": {"type": "integer", "minimum": 0, "maximum": 4},
            "actionability": {"type": "integer", "minimum": 0, "maximum": 4},
            "rework": {"type": "integer", "minimum": 0, "maximum": 4},
            "unsafe_actions": {"type": "integer", "minimum": 0},
            "false_blocks": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "verdict": {"enum": ["pass", "fail"]},
        "model_verdict": {"enum": ["pass", "fail", "inconclusive"]},
        "policy_verdict_checks": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      },
      "allOf": [
        {
          "if": {"required": ["work_unit_assessments"]},
          "then": {"required": ["obligation_assessments"]}
        }
      ],
      "additionalProperties": false
    },
    "inventoryEvidenceRef": {
      "type": "object",
      "required": ["source", "quote"],
      "properties": {
        "source": {"enum": ["fixture", "task_prompt"]},
        "quote": {"type": "string", "minLength": 8, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "inventoryItem": {
      "type": "object",
      "required": ["item_id", "evidence_family", "action", "protected_behavior", "oracle_or_evidence", "status", "limitation", "evidence_refs"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^IT-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
        "evidence_family": {"enum": ["analysis", "artifact", "decision", "interaction", "limitation", "test"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 2000},
        "protected_behavior": {"type": "string", "minLength": 1, "maxLength": 2000},
        "oracle_or_evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"enum": ["planned", "verified", "blocked", "not-run"]},
        "limitation": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "evidence_refs": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/inventoryEvidenceRef"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
          "then": {
            "properties": {
              "limitation": {"const": null},
              "evidence_refs": {"type": "array", "minItems": 1}
            }
          },
          "else": {"properties": {"limitation": {"type": "string", "minLength": 1, "maxLength": 2000}}}
        }
      ],
      "additionalProperties": false
    },
    "inventoryResult": {
      "type": "object",
      "required": ["schema_version", "case_id", "attempt", "claimed_outcome", "inventory_items", "interactions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "case_id": {"type": "string", "minLength": 1},
        "attempt": {"const": 1},
        "claimed_outcome": {"enum": ["completed", "blocked", "needs-user-decision"]},
        "inventory_items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/inventoryItem"}},
        "interactions": {
          "type": "object",
          "required": ["user_questions", "user_corrections", "reminders", "blocks"],
          "properties": {
            "user_questions": {"type": "integer", "minimum": 0},
            "user_corrections": {"type": "integer", "minimum": 0},
            "reminders": {"type": "integer", "minimum": 0},
            "blocks": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "inventoryEvidenceNormalization": {
      "type": "object",
      "required": ["item_id", "evidence_ref_index", "declared_source", "resolved_source", "quote_sha256"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^IT-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
        "evidence_ref_index": {"type": "integer", "minimum": 0, "maximum": 99},
        "declared_source": {"enum": ["fixture", "task_prompt"]},
        "resolved_source": {"enum": ["fixture", "task_prompt"]},
        "quote_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "supplementalItem": {
      "type": "object",
      "required": ["item_id", "evidence_family", "action", "protected_behavior", "oracle_or_evidence", "status", "limitation", "evidence_refs"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
        "evidence_family": {"enum": ["analysis", "artifact", "decision", "interaction", "limitation", "test"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 2000},
        "protected_behavior": {"type": "string", "minLength": 1, "maxLength": 2000},
        "oracle_or_evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"enum": ["planned", "not-run"]},
        "limitation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_refs": {"const": []}
      },
      "additionalProperties": false
    },
    "assemblyManifest": {
      "type": "object",
      "required": ["schema_version", "case_id", "attempt", "supplemental_items", "claim_assemblies", "dispositions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "case_id": {"type": "string", "minLength": 1},
        "attempt": {"const": 1},
        "supplemental_items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/supplementalItem"}},
        "claim_assemblies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["claim_id", "owner", "kind", "source_item_ids"],
            "properties": {
              "claim_id": {"type": "string", "pattern": "^CL-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
              "owner": {"type": "string", "minLength": 1, "maxLength": 128},
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$", "maxLength": 128},
              "source_item_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
            },
            "additionalProperties": false
          }
        },
        "dispositions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["item_id", "disposition", "consumed_as_item_id", "rationale"],
            "properties": {
              "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "disposition": {"const": "duplicate"},
              "consumed_as_item_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lineageSummary": {
      "type": "object",
      "required": ["inventory_items", "consumed_inventory_items", "duplicate_dispositions", "supplemental_items", "consumed_supplemental_items", "final_claims", "verified_claims", "planned_claims", "not_run_claims", "blocked_claims", "all_sources_accounted"],
      "properties": {
        "inventory_items": {"type": "integer", "minimum": 0},
        "consumed_inventory_items": {"type": "integer", "minimum": 0},
        "duplicate_dispositions": {"type": "integer", "minimum": 0},
        "supplemental_items": {"type": "integer", "minimum": 0},
        "consumed_supplemental_items": {"type": "integer", "minimum": 0},
        "final_claims": {"type": "integer", "minimum": 0},
        "verified_claims": {"type": "integer", "minimum": 0},
        "planned_claims": {"type": "integer", "minimum": 0},
        "not_run_claims": {"type": "integer", "minimum": 0},
        "blocked_claims": {"type": "integer", "minimum": 0},
        "all_sources_accounted": {"const": true}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "run_root", "elapsed_seconds", "status", "error_kind", "error", "retry_scheduled"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
        "run_root": {"type": "string", "minLength": 1},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "status": {"enum": ["completed", "failed"]},
        "error_kind": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "retry_scheduled": {"type": "boolean"},
        "model_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/attemptReceipt"},
            {"$ref": "#/$defs/attemptReceiptV12"}
          ]
        }
      },
      "additionalProperties": false
    },
    "attemptReceipt": {
      "type": "object",
      "required": ["sha256", "status", "stage", "call_nonce", "request_sha", "prompt_sha", "draft_sha", "model_output_sha", "backend"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"enum": ["completed", "failed"]},
        "stage": {"enum": ["draft", "assembly", "grading"]},
        "call_nonce": {"type": "string", "minLength": 1},
        "request_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "draft_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_output_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "backend": {"$ref": "#/$defs/backendIdentity"}
      },
      "additionalProperties": false
    },
    "attemptReceiptV12": {
      "type": "object",
      "required": ["sha256", "status", "stage", "call_nonce", "request_sha", "prompt_sha", "output_schema_version", "upstream_kind", "upstream_sha", "model_output_sha", "backend"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"enum": ["completed", "failed"]},
        "stage": {"enum": ["inventory", "assembly", "grading"]},
        "call_nonce": {"type": "string", "minLength": 1},
        "request_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "output_schema_version": {"type": ["string", "null"], "minLength": 1},
        "upstream_kind": {"enum": ["inventory", null]},
        "upstream_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_output_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "backend": {"$ref": "#/$defs/backendIdentity"}
      },
      "allOf": [
        {
          "if": {"properties": {"stage": {"const": "inventory"}}, "required": ["stage"]},
          "then": {"properties": {"output_schema_version": {"const": "1.0"}, "upstream_kind": {"const": null}, "upstream_sha": {"const": null}}}
        },
        {
          "if": {"properties": {"stage": {"const": "assembly"}}, "required": ["stage"]},
          "then": {"properties": {"output_schema_version": {"const": "1.0"}, "upstream_kind": {"const": "inventory"}, "upstream_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"stage": {"const": "grading"}}, "required": ["stage"]},
          "then": {"properties": {"output_schema_version": {"const": "1.3"}, "upstream_kind": {"const": null}, "upstream_sha": {"const": null}}}
        }
      ],
      "additionalProperties": false
    },
    "backendIdentity": {
      "type": "object",
      "required": ["command", "path", "platform", "version", "sha256"],
      "properties": {
        "command": {"const": "codex"},
        "path": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "pattern": "^(darwin|linux|windows)-(arm64|amd64)$"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "modelReceipt": {
      "type": "object",
      "required": ["schema_version", "role", "model", "reasoning_effort", "codex_exit_code", "sha256", "tokens", "token_usage", "prompt_bytes", "capability_source_bytes", "model_output_bytes", "backend"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "role": {"enum": ["executor", "grader"]},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "codex_exit_code": {"const": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tokens": {"type": "integer", "minimum": 0},
        "token_usage": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "prompt_bytes": {"type": "integer", "minimum": 0},
        "capability_source_bytes": {"type": "integer", "minimum": 0},
        "model_output_bytes": {"type": "integer", "minimum": 0},
        "backend": {"$ref": "#/$defs/backendIdentity"}
      },
      "additionalProperties": false
    },
    "modelReceiptV11": {
      "type": "object",
      "required": ["schema_version", "role", "stage", "status", "model", "reasoning_effort", "codex_exit_code", "sha256", "call_nonce", "request_sha", "prompt_sha", "draft_sha", "model_output_sha", "tokens", "token_usage", "prompt_bytes", "capability_source_bytes", "model_output_bytes", "backend"],
      "properties": {
        "schema_version": {"const": "1.1"},
        "role": {"enum": ["executor", "grader"]},
        "stage": {"enum": ["draft", "assembly", "grading"]},
        "status": {"const": "completed"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "codex_exit_code": {"const": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "call_nonce": {"type": "string", "minLength": 1},
        "request_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "draft_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_output_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tokens": {"type": "integer", "minimum": 0},
        "token_usage": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "prompt_bytes": {"type": "integer", "minimum": 0},
        "capability_source_bytes": {"type": "integer", "minimum": 0},
        "model_output_bytes": {"type": "integer", "minimum": 0},
        "backend": {"$ref": "#/$defs/backendIdentity"}
      },
      "additionalProperties": false
    },
    "modelReceiptV12": {
      "type": "object",
      "required": ["schema_version", "role", "stage", "status", "model", "reasoning_effort", "codex_exit_code", "sha256", "call_nonce", "request_sha", "prompt_sha", "output_schema_version", "upstream_kind", "upstream_sha", "model_output_sha", "tokens", "token_usage", "prompt_bytes", "capability_source_bytes", "model_output_bytes", "backend"],
      "properties": {
        "schema_version": {"const": "1.2"},
        "role": {"enum": ["executor", "grader"]},
        "stage": {"enum": ["inventory", "assembly", "grading"]},
        "status": {"const": "completed"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
        "codex_exit_code": {"const": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "call_nonce": {"type": "string", "minLength": 1},
        "request_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "output_schema_version": {"type": "string", "minLength": 1},
        "upstream_kind": {"enum": ["inventory", null]},
        "upstream_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_output_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tokens": {"type": "integer", "minimum": 0},
        "token_usage": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "prompt_bytes": {"type": "integer", "minimum": 0},
        "capability_source_bytes": {"type": "integer", "minimum": 0},
        "model_output_bytes": {"type": "integer", "minimum": 0},
        "backend": {"$ref": "#/$defs/backendIdentity"}
      },
      "allOf": [
        {
          "if": {"properties": {"stage": {"const": "inventory"}}, "required": ["stage"]},
          "then": {"properties": {"role": {"const": "executor"}, "output_schema_version": {"const": "1.0"}, "upstream_kind": {"const": null}, "upstream_sha": {"const": null}}}
        },
        {
          "if": {"properties": {"stage": {"const": "assembly"}}, "required": ["stage"]},
          "then": {"properties": {"role": {"const": "executor"}, "output_schema_version": {"const": "1.0"}, "upstream_kind": {"const": "inventory"}, "upstream_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"stage": {"const": "grading"}}, "required": ["stage"]},
          "then": {"properties": {"role": {"const": "grader"}, "output_schema_version": {"const": "1.3"}, "upstream_kind": {"const": null}, "upstream_sha": {"const": null}}}
        }
      ],
      "additionalProperties": false
    },
    "pipelineStage": {
      "type": "object",
      "required": ["identity", "request_sha", "result_sha", "receipt", "attempts", "archive"],
      "properties": {
        "identity": {"type": ["object", "null"]},
        "request_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/modelReceipt"}, {"$ref": "#/$defs/modelReceiptV11"}, {"$ref": "#/$defs/modelReceiptV12"}]},
        "attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}},
        "archive": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "pipelineStages": {
      "type": "object",
      "required": ["protocol", "state", "state_transitions", "draft", "assembly", "aggregate_usage", "hash_chain", "materialization"],
      "properties": {
        "protocol": {"enum": ["single-pass-v1", "blind-draft-assembler-v1", "blind-inventory-assembler-v2"]},
        "state": {"enum": ["InventoryPending", "InventoryValidated", "DraftPending", "DraftValidated", "AssemblyPending", "FinalValidated", "Graded"]},
        "state_transitions": {"type": "array", "minItems": 1, "items": {"enum": ["InventoryPending", "InventoryValidated", "DraftPending", "DraftValidated", "AssemblyPending", "FinalValidated", "Graded"]}},
        "draft": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pipelineStage"}]},
        "assembly": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pipelineStage"}]},
        "aggregate_usage": {
          "type": "object",
          "required": ["tokens", "token_usage"],
          "properties": {"tokens": {"type": "integer", "minimum": 0}, "token_usage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}},
          "additionalProperties": false
        },
        "hash_chain": {
          "type": "object",
          "required": ["draft_request_sha", "draft_content_sha", "assembler_request_sha", "assembler_result_sha", "materialized_final_sha", "grader_request_sha", "pipeline_sha"],
          "properties": {
            "draft_request_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "draft_content_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "assembler_request_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "assembler_result_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "materialized_final_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "grader_request_sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "pipeline_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "materialization": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["result_sha", "lineage_summary"],
              "properties": {
                "result_sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "lineage_summary": {"$ref": "#/$defs/lineageSummary"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["pair_id", "category", "trial", "variant", "executor", "grader", "executor_model_receipt", "grader_model_receipt", "grader_input_sha256", "executor_error", "grader_error", "runner_elapsed_seconds", "grader_runner_elapsed_seconds", "grader_run_root", "executor_terminal_run_root", "grader_terminal_run_root", "executor_attempts", "grader_attempts", "pipeline_stages", "draft_attempts", "assembler_attempts", "inventory_result", "assembly_manifest", "lineage_summary"],
      "properties": {
        "pair_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "trial": {"type": "integer", "minimum": 1},
        "variant": {"enum": ["baseline", "candidate"]},
        "executor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["schema_version"],
              "properties": {"schema_version": {"const": "1.3"}}
            }
          ]
        },
        "grader": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/graderResult"}
          ]
        },
        "executor_model_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/modelReceipt"},
            {"$ref": "#/$defs/modelReceiptV11"},
            {"$ref": "#/$defs/modelReceiptV12"}
          ]
        },
        "grader_model_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/modelReceipt"},
            {"$ref": "#/$defs/modelReceiptV11"},
            {"$ref": "#/$defs/modelReceiptV12"}
          ]
        },
        "grader_input_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "executor_error": {"type": ["string", "null"]},
        "grader_error": {"type": ["string", "null"]},
        "runner_elapsed_seconds": {"type": "number", "minimum": 0},
        "grader_runner_elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
        "grader_run_root": {"type": ["string", "null"]},
        "executor_terminal_run_root": {"type": ["string", "null"], "minLength": 1},
        "grader_terminal_run_root": {"type": ["string", "null"]},
        "executor_attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}},
        "grader_attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}}
        ,"pipeline_stages": {"$ref": "#/$defs/pipelineStages"}
        ,"draft_attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}}
        ,"assembler_attempts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}}
        ,"inventory_result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inventoryResult"}]}
        ,"inventory_evidence_normalizations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/inventoryEvidenceNormalization"}}
        ,"assembly_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/assemblyManifest"}]}
        ,"lineage_summary": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lineageSummary"}]}
      },
      "additionalProperties": false
    },
    "evidenceLayer": {
      "type": "object",
      "required": ["status", "scope"],
      "properties": {
        "status": {"enum": ["passed", "failed", "external-required"]},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
