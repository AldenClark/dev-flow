{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev Flow executor result",
  "type": "object",
  "required": ["schema_version", "case_id", "attempt", "artifact_root", "claimed_outcome", "actions", "evidence", "claims", "interactions", "usage"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.3"},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "artifact_root": {"type": "string", "minLength": 1},
    "claimed_outcome": {"type": "string", "enum": ["completed", "blocked", "needs-user-decision"]},
    "actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["claim_id", "owner", "kind", "action", "protected_behavior", "oracle_or_evidence", "status", "limitation"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CL-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128},
          "owner": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$", "maxLength": 128},
          "action": {"type": "string", "minLength": 1, "maxLength": 2000},
          "protected_behavior": {"type": "string", "minLength": 1, "maxLength": 2000},
          "oracle_or_evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
          "status": {"type": "string", "enum": ["planned", "verified", "blocked", "not-run"]},
          "limitation": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "object",
      "required": ["user_questions", "user_corrections", "reminders", "blocks"],
      "properties": {
        "user_questions": {"type": "integer", "minimum": 0},
        "user_corrections": {"type": "integer", "minimum": 0},
        "reminders": {"type": "integer", "minimum": 0},
        "blocks": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["tokens", "elapsed_seconds", "cost"],
      "properties": {
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
