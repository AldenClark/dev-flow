      "native_evidence": ["Cargo.toml", "**/Cargo.toml", "rustfmt.toml", ".rustfmt.toml", "clippy.toml", ".clippy.toml"],
      "route_names": ["rust-code-review", "review-rust"],
      "preferred_route": "rust-code-review",
      "manual_fallback": "qualified-rust-reviewer"
    },
    {
      "id": "quality.rust.async",
