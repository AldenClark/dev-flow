{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AldenClark/dev-flow/schemas/readiness-suppression-v1.json",
  "title": "Dev Flow readiness reminder suppressions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suppressions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "owner", "reason", "tiers", "expires_at"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "owner": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "tiers": {"type": "array", "items": {"enum": ["T0", "T1", "T2", "T3"]}},
          "expires_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
