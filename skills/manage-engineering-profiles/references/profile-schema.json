{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AldenClark/dev-flow/schemas/preference-profile-v1.json",
  "title": "Dev Flow engineering preference profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "layer", "owner", "version", "status", "preferences"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "layer": {"enum": ["baseline", "personal", "team", "project", "component", "task"]},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "trial", "active", "deprecated", "retired"]},
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "kind", "strength", "rationale", "exception_policy", "review_trigger"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "kind": {"enum": ["constraint", "preference", "quality-policy"]},
          "strength": {"enum": ["must", "should", "may"]},
          "value": {},
          "outcome": {"type": "string", "minLength": 1},
          "applies_when": {"type": "array", "items": {"type": "string"}},
          "avoid_when": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "exception_policy": {"type": "string", "minLength": 1},
          "exception_id": {"type": "string", "minLength": 1},
          "review_trigger": {"type": "string", "minLength": 1},
          "required_evidence": {"type": "array", "items": {"type": "string"}},
          "required_capabilities": {"type": "array", "items": {"type": "string"}},
          "fallbacks": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  }
}
