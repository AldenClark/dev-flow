{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AldenClark/dev-flow/schemas/preference-decision-v1.json",
  "title": "Dev Flow scoped preference exception v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "approved_by", "keys", "scope", "reason", "residual_risk", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^PREF-[A-Za-z0-9._-]+$"},
    "status": {"enum": ["active", "expired", "superseded", "retired"]},
    "approved_by": {"type": "string", "minLength": 1},
    "keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "reason": {"type": "string", "minLength": 1},
    "residual_risk": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
